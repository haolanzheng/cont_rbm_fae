{
  "data_directory": "data_128_formal2048",
  "backend": "jax",
  "model": {
    "encoder_kind": "darcy_unet",
    "encoder_input_features": "raw",
    "encoder_use_mask_channel": false,
    "encoder_channels": [
      32,
      64,
      128
    ],
    "encoder_blocks_per_level": 1,
    "shared_initialization_reference": {
      "width": 32,
      "modes": 8
    },
    "latent_dimension": 128,
    "pool_channels": 16,
    "kernel_hidden": 64,
    "pooling_kind": "orthogonal_integral",
    "orthogonal_epsilon": 0.001,
    "decoder_kind": "conditional_mlp",
    "decoder_width": 256,
    "decoder_blocks": 6,
    "decoder_latent_scale": 1,
    "coordinate_frequencies": 6
  },
  "training": {
    "train_size": 2048,
    "batch_size": 64,
    "epochs": 300,
    "warmup_epochs": 0,
    "learning_rate": 0.001,
    "minimum_learning_rate": 1e-05,
    "beta1": 0.9,
    "beta2": 0.999,
    "epsilon": 1e-08,
    "weight_decay": 0,
    "latent_penalty": 0.0001,
    "gradient_clip": 1,
    "seed": 310519,
    "threads": 4,
    "max_real_parameters": 2000000,
    "evaluation_interval_epochs": 5,
    "input_mode": "clean_noisy_pair",
    "noise_kind": "iid_gaussian",
    "noise_std": 0.05
  }
}
